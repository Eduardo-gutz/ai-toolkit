{
  "$schema": "./ai-toolkit.schema.json",
  "version": "0.1.0",
  "source": "./source",

  "tools": {
    "opencode": {
      "enabled": true,
      "skills_target": ".claude/skills",
      "skills_strategy": "shared-via-claude-compat",
      "rules_target": "AGENTS.md",
      "agents_target": ".opencode/agents",
      "commands_target": ".opencode/commands",
      "mcp_target": "opencode.json#mcp"
    },
    "claude-code": {
      "enabled": true,
      "skills_target": ".claude/skills",
      "rules_target": "CLAUDE.md",
      "agents_target": ".claude/agents",
      "commands_target": ".claude/commands",
      "mcp_target": ".mcp.json"
    }
  },

  "default_tools": ["opencode", "claude-code"],

  "install": {
    "strategy": "symlink",
    "backup_existing": true,
    "state_file": ".ai-toolkit.json"
  }
}
